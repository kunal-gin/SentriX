{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentriX Telemetry Payload",
  "type": "object",
  "required": ["agent_id", "timestamp", "sequence", "metrics"],
  "properties": {
    "agent_id": { "type": "string", "format": "uuid" },
    "timestamp": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 0 },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "unit"],
        "properties": {
          "name": { "type": "string", "pattern": "^system\\.[a-z0-9_]+\\.[a-z0-9_]+$" },
          "value": { "type": "number" },
          "unit": { "type": "string", "enum": ["percent", "bytes", "bytes_per_sec", "count", "seconds"] },
          "labels": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    }
  }
}
